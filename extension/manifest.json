{
  "manifest_version": 3,
  "name": "Dip",
  "version": "0.1.0",
  "description": "Watch prices. Privately.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Dip",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting"],
  "optional_host_permissions": ["*://*/*"]
}
